# =====================================================================
# W3 fix (DEC-R1-001): DO NOT copy this file to `.env` and run it as-is.
# Every value below is a placeholder — replace ALL of them before use,
# especially the two marked "set ... in .env" in docker-compose.yml
# (compose will refuse to start until you do).
# =====================================================================

# --- Database ---
DB_NAME=rest_api
DB_USER=rest_api
DB_PASS=change_this_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# --- JWT ---
# Generate one with: php -r "echo bin2hex(random_bytes(64));"
JWT_SECRET_KEY=change_this_to_a_random_64_byte_hex_string

# --- App ---
URL_ROOT=http://localhost:8080/api
HTTP_PORT=8080
APP_VERSION=dev

# --- Mail (optional, used by app/helpers/index.php sendMail()) ---
# Not wired into any controller yet — see docs/architecture.md "Roadmap".
SMTP_USERNAME=change_this@example.com
SMTP_PASSWORD=change_this_app_password
SMTP_FROM_EMAIL=change_this@example.com
SMTP_TEST_RECIPIENT=change_this@example.com
